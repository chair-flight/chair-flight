{
  "name": "chair-flight",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "node src/tools/with-env.ts vite dev",
    "build": "biome check && tsc --noEmit && node --env-file-if-exists=.env node_modules/vite/bin/vite.js build",
    "preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "supabase:start": "supabase start -x kong",
    "supabase:stop": "supabase stop",
    "supabase:migrate": "node src/tools/with-env.ts drizzle-kit migrate --config src/database/drizzle.config.ts"
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@tanstack/react-virtual": "3.14.28",
    "@tanstack/start-static-server-functions": "1.167.44",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "nitro": "3.0.261103-rc",
    "supabase": "3.4.0",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  }
}
